# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Raw / large data (fetch via scripts/download_data.py)
data/*
!data/README.md
!data/.gitkeep

# Generated figure outputs (keep the directory, drop the contents)
figures/*/output/*
!figures/*/output/.gitkeep

# Reconstructed volumes (large, generated from raw holograms)
reconstructions/*
!reconstructions/.gitkeep

# Local overrides
.env
.env.local
